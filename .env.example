# Copy this file to .env and fill in real values. Never commit the real .env file.

# --- Postgres ---
POSTGRES_DB=golden_market
POSTGRES_USER=golden_market_admin
POSTGRES_PASSWORD=change_me_to_a_strong_password

# --- n8n ---
N8N_HOST=n8n.tondomaine.com
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change_me_to_a_strong_password

# --- WhatsApp Cloud API (used inside n8n workflow, not by docker-compose directly) ---
# WHATSAPP_PHONE_NUMBER_ID=
# WHATSAPP_ACCESS_TOKEN=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_BUSINESS_ACCOUNT_ID=

# --- Anthropic (used inside n8n workflow) ---
# ANTHROPIC_API_KEY=

# --- Notifications humaines (escalade) ---
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# --- Mobile Money (infos statiques affichées au client, pas d'API pour l'instant) ---
# ORANGE_MONEY_NUMBER=
# ORANGE_MONEY_NAME=Golden Market
